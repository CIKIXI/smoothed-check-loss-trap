%% Minimal shim for the `textcase` package.
%%
%% The imsart class (IMS / Annals of Statistics) loads textcase, which is no longer
%% distributed as a separate file: since the 2022 LaTeX kernel release its functionality
%% is part of the format (\MakeUppercase, \MakeTextUppercase, \MakeTextLowercase,
%% \NoCaseChange).  This file simply exposes those commands under the names imsart uses,
%% so that the class can be compiled on a TeX installation that lacks the old package.
%% It provides no new functionality and is only used for the local build of the
%% submission file: with a full TeX Live installation the real textcase is found first.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{textcase}[2024/01/01 v1.0 shim for the kernel text-case commands]
\@ifundefined{MakeTextUppercase}{%
  \newcommand{\MakeTextUppercase}[1]{\MakeUppercase{#1}}%
}{}
\@ifundefined{MakeTextLowercase}{%
  \newcommand{\MakeTextLowercase}[1]{\MakeLowercase{#1}}%
}{}
\@ifundefined{NoCaseChange}{%
  \newcommand{\NoCaseChange}[1]{#1}%
}{}
\endinput
